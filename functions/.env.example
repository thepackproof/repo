PUBLIC_APP_URL=https://YOUR_PROJECT.web.app
CONNECT_LINK_BASE_URL=https://packproof.link
API_ENVIRONMENT=sandbox
TIKTOK_REDIRECT_URI=https://us-central1-YOUR_PROJECT.cloudfunctions.net/tiktokAuthCallback
ENABLE_TIKTOK_AUTH=false
ENABLE_REVENUECAT_BILLING=false

# Configure enabled secrets with `npx firebase-tools@15.25.1 functions:secrets:set NAME`.
# API_CREDENTIAL_PEPPER is required by the merchant API. Do not place its value
# in this file; set it in Firebase Secret Manager and pass the identical value
# only through a secure local environment when provisioning a credential.
# PUBLIC_HANDOFF_SIGNING_SECRET is independently required by the public Button
# API to mint short-lived bearer handoffs. Keep it in Firebase Secret Manager;
# publishable Button keys are intentionally non-secret and are stored only as hashes.
# PARTICIPANT_HANDOFF_SIGNING_SECRET is independently required by participant
# claim and evidence-session handoffs. Store it only in Firebase Secret Manager;
# do not reuse the API credential pepper, public-handoff key, or manifest key.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
REVENUECAT_WEBHOOK_SECRET=
MANIFEST_SIGNING_SECRET=
MANIFEST_SIGNING_KEY_ID=manifest-hmac-v1
