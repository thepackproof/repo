# Public mobile configuration. These values identify services but are not server secrets.
EXPO_OWNER=
EXPO_PROJECT_ID=
FIREBASE_PROJECT_ID=
ANDROID_PACKAGE_NAME=com.thepackproof.app
GOOGLE_SERVICES_JSON=./google-services.json

EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-east1

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_ENABLE_FACEBOOK_AUTH=false
EXPO_PUBLIC_ENABLE_TIKTOK_AUTH=false
EXPO_PUBLIC_ENABLE_REVENUECAT_BILLING=false
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=
EXPO_PUBLIC_LEGAL_BASE_URL=https://packproof-4cf53.web.app
PACKPROOF_LINK_DOMAIN=packproof.link

# Release builds use Play Integrity. Set debug only for a registered App Check
# debug token on a sideloaded preview APK. Do not set this for Play production.
# EXPO_PUBLIC_APP_CHECK_PROVIDER=debug

FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=

# Used only by `npm run generate:assetlinks`; add one or more comma-separated
# SHA-256 certificate fingerprints after EAS or Play creates the signing key.
ANDROID_APP_LINK_SHA256_CERT_FINGERPRINT=

# Used by the idempotent configuration helper to finalize public pages.
PACKPROOF_LEGAL_ENTITY=
PACKPROOF_SUPPORT_EMAIL=
PACKPROOF_POLICY_EFFECTIVE_DATE=
