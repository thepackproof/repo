rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isParticipant(transactionId) {
      return signedIn()
        && exists(/databases/$(database)/documents/transactions/$(transactionId))
        && request.auth.uid in get(/databases/$(database)/documents/transactions/$(transactionId)).data.participantIds;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
      match /blocks/{blockedId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }
      match /exports/{exportId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /publicProfiles/{userId} {
      // Client code only fetches a known UID. Listing would enumerate member
      // display names and photos for every signed-in account.
      allow get: if signedIn();
      allow list, write: if false;
    }

    match /transactions/{transactionId} {
      // Collection queries must be provable from each candidate document.
      // The same-document get() helper is appropriate for nested collections,
      // but cannot safely authorize a top-level list query.
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow write: if false;

      match /evidence/{evidenceId} {
        allow read: if isParticipant(transactionId);
        allow write: if false;
      }
      match /events/{eventId} {
        allow read: if isParticipant(transactionId);
        allow write: if false;
      }
      match /packets/{packetId} {
        allow read: if isParticipant(transactionId);
        allow write: if false;
      }
      match /returns/{returnPassportId} {
        allow read: if isParticipant(transactionId);
        allow write: if false;
      }
    }

    match /pendingUploads/{uploadId} { allow read, write: if false; }
    match /invites/{inviteId} { allow read, write: if false; }
    match /reports/{reportId} { allow read, write: if false; }
    match /billingEvents/{eventId} { allow read, write: if false; }
    match /oauthStates/{stateId} { allow read, write: if false; }
    match /authGrants/{grantId} { allow read, write: if false; }
    match /captureSessions/{sessionId} { allow read, write: if false; }
    match /connectSessions/{sessionId} { allow read, write: if false; }
    match /commerceContexts/{commerceContextId} { allow read, write: if false; }
    match /passportDrafts/{passportDraftId} { allow read, write: if false; }
    match /publicCommerceHandoffs/{handoffId} { allow read, write: if false; }
    match /participantClaims/{claimId} { allow read, write: if false; }
    match /evidenceSessions/{evidenceSessionId} { allow read, write: if false; }
    match /domainOutbox/{eventId} { allow read, write: if false; }
    match /platformIntegrations/{integrationId} { allow read, write: if false; }
    match /webhookDeliveries/{deliveryId} { allow read, write: if false; }
    match /providerLinks/{providerId} { allow read, write: if false; }
    match /apiCredentials/{credentialId} { allow read, write: if false; }
    match /apiClients/{clientId} { allow read, write: if false; }
    match /organizations/{organizationId} { allow read, write: if false; }
    match /apiIdempotencyRecords/{recordId} { allow read, write: if false; }
    match /apiRateLimits/{limitId} { allow read, write: if false; }
    match /apiAuditStreams/{streamId} { allow read, write: if false; }
    match /webDeletionTokens/{tokenId} { allow read, write: if false; }
    match /deletionRateLimits/{limitId} { allow read, write: if false; }
    match /mail/{messageId} { allow read, write: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
